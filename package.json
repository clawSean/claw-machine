{
  "name": "claw-machine",
  "version": "0.4.0",
  "description": "OpenClaw hook that auto-injects contact and group profiles into agent context at bootstrap",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "node --disable-warning=ExperimentalWarning scripts/build.mjs",
    "test": "npm run build && node --test test/*.test.mjs",
    "benchmark": "npm run build && node scripts/benchmark.mjs",
    "audit": "npm run build && node scripts/audit-contacts.mjs",
    "install:hook": "npm run test && mkdir -p ~/.openclaw/hooks/profile-injector && cp handler.js HOOK.md ~/.openclaw/hooks/profile-injector/"
  },
  "openclaw": {
    "hooks": ["./"]
  },
  "keywords": [
    "openclaw",
    "hook",
    "profile",
    "bootstrap",
    "contacts",
    "groups",
    "social-awareness"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/clawSean/claw-machine.git"
  }
}
